# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only: API routes for uploads, reorder, and layout saves (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Storage bucket name (must exist in Supabase; see supabase/schema.sql)
NEXT_PUBLIC_STORAGE_BUCKET=room-images

# Show dev floor-plan editor (toggle + ?edit=1 also works)
NEXT_PUBLIC_SHOW_FLOORPLAN_EDIT=false
